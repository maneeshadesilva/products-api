@startuml
class Product {
 - id : Long
 - name : String
 - price : double
 + getId() : Long
 + getName() : String
 + getPrice() : double
 + setId(id : Long) : void
 + setName(name : String) : void
 + setPrice(price : double) : void
}

class DigitalProduct {
 - downloadUrl : String
 - fileSizeMB : double
 + getDownloadUrl() : String
 + getFileSizeMB() : double
}

class PhysicalProduct {
 - weightKg : double
 - dimensions : String
 + getWeightKg() : double
 + getDimensions() : String
}

' <|-- is inheritance: the hollow triangle sits at the PARENT
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
@enduml